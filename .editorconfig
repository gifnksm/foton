root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
# Rust sources can contain leading spaces that are not indent-size policy
# violations, for example when rustfmt moves `{` onto its own line for some
# long nested zero-arg functions, or when test fixtures in raw strings /
# `indoc!` encode their own indentation. editorconfig-checker cannot
# distinguish those cases from code indentation, so disable Rust indent-size
# checks here.
indent_size = unset

[*.{toml,json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = unset

[Makefile]
indent_style = tab

[LICENSE*]
indent_size = unset
